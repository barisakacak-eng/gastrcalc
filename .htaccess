# Lauf 3, Phase 7 (09.11.2026): für den Umzug auf Uberspace (Apache). Auf GitHub Pages ohne Wirkung.
# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# MIME-Typen
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs
AddType application/wasm .wasm
AddType image/svg+xml .svg
AddType image/webp .webp
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Service Worker und Einstieg nie aus dem Cache: sonst bleibt eine alte Fassung hängen
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "^manifest\.json$">
    ForceType application/manifest+json
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Keine Verzeichnislisten
Options -Indexes
